generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Section {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  works     Work[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Work {
  id          String   @id @default(cuid())
  title       String
  client      String?
  videoUrl    String?
  thumbnail   String?
  description String?
  tags        String[]
  locationLabel String?
  locationCity  String?
  locationCountry String?
  locationLat   Float?
  locationLng   Float?
  showOnMap     Boolean  @default(false)
  isVisible   Boolean  @default(true)
  order       Int      @default(0)
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id        String   @id @default(cuid())
  name      String
  logo      String
  order     Int
  isVisible Boolean  @default(true)
}

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model HeroConfig {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  ctaLabel  String
  ctaLink   String
  videoUrl  String
  posterUrl String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stat {
  id        String   @id @default(cuid())
  label     String
  value     Int
  prefix    String?
  suffix    String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  quote     String
  rating    Int
  photo     String?
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActiveGovernorate {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LegacyWorkLocation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectName String   @map("project_name")
  clientName  String?  @map("client_name")
  city        String
  governorate String?
  lat         Decimal  @db.Decimal
  lng         Decimal  @db.Decimal
  category    String
  description String?
  projectUrl  String?  @map("project_url")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("work_locations")
}

model LegacyLocationWork {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId   String    @map("location_id") @db.Uuid
  title        String
  clientName   String?   @map("client_name")
  videoUrl     String?   @map("video_url")
  thumbnailUrl String?   @map("thumbnail_url")
  description  String?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("location_works")
}
